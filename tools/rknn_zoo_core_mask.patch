rknn_model_zoo 的 YOLOv8 C++ demo 加"选 NPU 核数"这一步（**可选**）。

用法（在 rknn_model_zoo 仓库根目录）：
    git clone --depth 1 https://github.com/airockchip/rknn_model_zoo.git
    patch -p1 -d rknn_model_zoo < tools/rknn_zoo_core_mask.patch
    bash rknn_model_zoo/build-linux.sh -t rk3588 -a aarch64 -d yolov8 -r -j

为什么需要它：librknnrt 默认 RKNN_NPU_CORE_AUTO(0)，那是"驱动自己挑一个核"，
落到内核里就是**单核**（vendor 的 rknpu_schedule_core_index() 在 AUTO 下强制
use_core_num = 1）。想用满三核必须显式调 rknn_set_core_mask()。

**补丁不改变默认行为**：只有给了可选的第 3 个参数才去调，不带参数跑仍是
已验证的 AUTO 路径。

    rknn_yolov8_demo <model> <image> [core_mask]

为什么用 argv 而不是环境变量：**本内核的 execve 不传环境变量**
（kernel/syscall/core/proc_lifecycle.c 里 `(void)envp;`），getenv() 永远是 NULL。

diff --git a/examples/yolov8/cpp/main.cc b/examples/yolov8/cpp/main.cc
index b963901..ee69408 100644
--- a/examples/yolov8/cpp/main.cc
+++ b/examples/yolov8/cpp/main.cc
@@ -34,14 +34,21 @@
 -------------------------------------------*/
 int main(int argc, char **argv)
 {
-    if (argc != 3)
+    if (argc < 3 || argc > 4)
     {
-        printf("%s <model_path> <image_path>\n", argv[0]);
+        printf("%s <model_path> <image_path> [core_mask]\n", argv[0]);
+        printf("  core_mask: 1=core0  3=core0+1  7=三核；省略=不设(librknnrt 默认 AUTO)\n");
         return -1;
     }
 
     const char *model_path = argv[1];
     const char *image_path = argv[2];
+    /* 第 3 个参数是 NPU 核数，透传给 rknn_set_core_mask()。
+     *
+     * 为什么用 argv 而不是环境变量：**本内核的 execve 不传环境变量**
+     * （kernel/syscall/core/proc_lifecycle.c 里 `(void)envp;`），所以
+     * getenv() 永远拿不到 shell 里设的变量。argv 是可靠的。 */
+    const char *core_mask_arg = (argc == 4) ? argv[3] : NULL;
 
     int ret;
     rknn_app_context_t rknn_app_ctx;
@@ -49,7 +56,7 @@ int main(int argc, char **argv)
 
     init_post_process();
 
-    ret = init_yolov8_model(model_path, &rknn_app_ctx);
+    ret = init_yolov8_model(model_path, core_mask_arg, &rknn_app_ctx);
     if (ret != 0)
     {
         printf("init_yolov8_model fail! ret=%d model_path=%s\n", ret, model_path);
