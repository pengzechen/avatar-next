@@ -54,6 +55,31 @@ int init_yolov8_model(const char *model_path, rknn_app_context_t *app_ctx)
         return -1;
     }
 
+    /*
+     * NPU 核数。**默认不动** —— 保持 librknnrt 的默认值
+     * RKNN_NPU_CORE_AUTO(0)，那是一条已经在真机上验证过的路径。
+     *
+     * 只有显式给了环境变量才去设，这样"三核"是个可选项而不是新的默认值：
+     * 万一多核有问题，不带参数跑还是好的。
+     *
+     *   RKNN_CORE_MASK=1 yolo    # 只 core0
+     *   RKNN_CORE_MASK=7 yolo    # 三核
+     *   yolo                     # 不设，AUTO（默认，已验证）
+     *
+     * 注意 AUTO 在内核侧 = 单核：vendor 的 rknpu_schedule_core_index() 在
+     * AUTO 下强制 use_core_num = 1，只挑一个核跑完整个 job。想用满三核
+     * 必须显式设成 7。
+     */
+    {
+        if (core_mask_arg) {
+            int mask = atoi(core_mask_arg);
+            int cm_ret = rknn_set_core_mask(ctx, (rknn_core_mask)mask);
+            printf("rknn_set_core_mask(%d) = %d\n", mask, cm_ret);
+        } else {
+            printf("未指定核数，用 librknnrt 默认 (AUTO=单核)\n");
+        }
+    }
+
     // Get Model Input Output Number
     rknn_input_output_num io_num;
     ret = rknn_query(ctx, RKNN_QUERY_IN_OUT_NUM, &io_num, sizeof(io_num));
