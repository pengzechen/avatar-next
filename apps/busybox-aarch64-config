# Busybox 配置文件 - Avatar OS AArch64 静态编译
#
# 交叉编译到 AArch64，使用 musl libc，静态链接

CONFIG_CROSS_COMPILER_PREFIX="aarch64-linux-musl-"
CONFIG_ARCH="aarch64"
CONFIG_STATIC=y
CONFIG_NO_SCRIPTS=y

# 基础功能
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_COMPRESS_USAGE=y

# 安装选项
CONFIG_INSTALL_NO_USR=y
CONFIG_PREFIX="./_install"

# 调试选项
CONFIG_DEBUG=y
CONFIG_DEBUG=y
CONFIG_WERROR=y

# 最小化配置 - 只启用基本命令
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"

# Shell
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_BUILTIN_ECHO=y
CONFIG_ASH_BUILTIN_TEST=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y

# 核心命令
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_PWD=y
CONFIG_CD=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_WHOAMI=y
CONFIG_ID=y
CONFIG_UNAME=y
CONFIG_DATE=y
CONFIG_SLEEP=y
CONFIG_SYNC=y

# 文件系统命令
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_LSOF=y

# 进程管理
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=y

# 网络基础
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_PING=y
CONFIG_INET_IPV6=y

# 编译优化
CONFIG_OPTIMIZATION_LEVEL=2
CONFIG_DEBUG_CRASH_OPTIONAL=y
CONFIG_ABORT=y

# 禁用不需要的功能
CONFIG_FEATURE_NITPICK=y
CONFIG_LONG_OPTS=y
