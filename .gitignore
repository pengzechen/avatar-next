# ─── 构建产物 ────────────────────────────────────────────────
/build
/ref
.arch

# rootfs staging（旧版脚本产物；现由 build/rootfs-stage-<arch> 取代）
/apps/*/rootfs

# ─── 工具 / 编辑器 ───────────────────────────────────────────
.clangd
compile_commands.json
/.cache/
__pycache__/
*.py[cod]

# ─── 第三方源码树 ────────────────────────────────────────────
# dropbear：vendored 构建树，仅保留交叉编译产物
/third_party/dropbear-2024.86/*
!/third_party/dropbear-2024.86/dropbearmulti-aarch64

# LTP：完整源码树不入库
/third_party/ltp/

# ─── NPU 运行时（第三方预编译二进制，不入库）─────────────────
# 19 MB，全是 Rockchip / glibc 的现成产物（librknnrt.so、glibc 运行时、
# 预编译的 rknpu2 demo），我们不产出也不修改它们。
# **只留 README**：那是唯一记录来源（上游 URL）和 glibc/musl 冲突说明的地方，
# 丢了就没法重建 rootfs。写法与上面 dropbear 那条一致。
/apps/rknn-aarch64/*
!/apps/rknn-aarch64/README.md

# NPU rootfs 镜像：纯产物，tools/make_npu_rootfs.sh 从 imgs/rootfs-aarch64.img
# + 上面的运行时重建，没必要入库（128 MiB）。
/imgs/rootfs-aarch64-npu.img

# ─── 测试产物 ────────────────────────────────────────────────
/tests/ltp/bin/
